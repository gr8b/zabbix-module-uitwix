{
  "manifest_version": "2",
  "type": "module",
  "author": "gr8b",
  "name": "UITwix",
  "description": "UI tasty tweaks, crunchy as a Twix.",
  "url": "https://zabbix.com",
  "id": "uitwix",
  "namespace": "UITwix",
  "version": "1.0",
  "assets": {
    "css": [],
    "js": []
  },
  "actions": {
    "mod.uitwix.assets": {
      "class": "Assets",
      "layout": "layout.uitwix.assets"
    },
    "mod.uitwix.form": {
      "class": "ConfigurationForm",
      "view": "mod.uitwix.form"
    },
    "mod.uitwix.form.update": {
      "class": "ConfigurationFormUpdate"
    }
  }
}
